pragma language_version 0.16;

import CompactStandardLibrary;

// ============================================================================
// COUNTER CONTRACT — Ownership-gated private counter
//
// PUBLIC (on-chain, visible to anyone who reads the ledger):
//   - count               : the running counter value
//   - owner_commitment    : a hash commitment to the owner's secret key
//                           (a hash, not the key itself)
//
// PRIVATE (never leaves the caller's machine, never written to the ledger):
//   - the owner's secret key, supplied via the `local_secret_key` witness
//
// WHAT IS PROVED WITHOUT BEING REVEALED:
//   Calling `increment` proves the caller knows the secret key whose hash
//   equals `owner_commitment`, without ever disclosing the key itself.
//   The only things that become public are the fact that the check passed
//   and the `amount` argument, which is wrapped in disclose() to make that
//   flow explicit and auditable in the compiled circuit.
// ============================================================================

export ledger count: Counter;
export ledger owner_commitment: Bytes<32>;

// Private witness: supplies the caller's secret key from local/private
// state. This value is never sent on-chain — only used inside the circuit
// to compute a hash that gets compared against the public commitment.
witness local_secret_key(): Bytes<32>;

// One-time setup circuit: commits to a secret without revealing it.
// Call this once when deploying/initializing a counter instance.
export circuit set_owner(): [] {
  const secret = local_secret_key();
  // disclose() marks that this hash (derived from private data) is
  // intentionally becoming public. The secret itself is never disclosed.
  const commitment = disclose(persistentHash<Bytes<32>>(secret));
  owner_commitment = commitment;
}

// Increment the public counter, gated on proof of ownership.
// The caller must know the secret key matching owner_commitment,
// but that key is never revealed — only the fact of a valid proof,
// plus the amount (explicitly disclosed), become public.
export circuit increment(amount: Uint<16>): [] {
  const secret = local_secret_key();
  const commitment = persistentHash<Bytes<32>>(secret);
  assert(commitment == owner_commitment, "increment: caller does not hold the owner secret");
  count.increment(disclose(amount));
}

// Public read-style circuit exposing the current count.
// (count is already `export ledger`, so this is provided for convenience
// when a frontend wants a single circuit call rather than a raw ledger read.)
export circuit get_count(): Uint<64> {
  return count.read();
}
